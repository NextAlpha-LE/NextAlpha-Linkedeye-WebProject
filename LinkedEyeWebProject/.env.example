# LinkedEye Environment Variables (Vault-first)
# Copy to .env in project root (next to manage.py)
# Keep only Vault bootstrap/connectivity values in .env.
# All app config/secrets should live in Vault bundle: secret/linkedeye/app

VAULT_APP_SECRETS_ENABLED=true
VAULT_APP_SECRETS_PATH=secret/linkedeye/app
VAULT_KV_VERSION=2

VAULT_SCHEME=http
VAULT_HOST=vault.fs-linkedeye
VAULT_PORT=8200

# Authentication to Vault (choose one)
# 1) Dev/bootstrap token
# VAULT_TOKEN=

# 2) AppRole (recommended for long-running deployments)
# VAULT_APP_ROLE_ID=
# VAULT_APP_SECRET_ID=

# Optional cache TTL for Vault bundle reads
VAULT_SECRETS_CACHE_TTL=300

# Seed all existing .env keys into Vault once:
#   python manage.py vault_seed_app_secrets --all-env

# Django runtime security controls
DJANGO_DEBUG=false
LE_ALLOWED_HOSTS=["linkedeye.finspot.in"]
LE_CORS_ALLOW_ALL=false
LE_CORS_ALLOWED_ORIGINS=["https://linkedeye.finspot.in"]
LE_CSRF_TRUSTED_ORIGINS=["https://linkedeye.finspot.in"]
LE_X_FRAME_OPTIONS=SAMEORIGIN
LE_SESSION_COOKIE_SECURE=true
LE_CSRF_COOKIE_SECURE=true
LE_SECURE_SSL_REDIRECT=true
LE_SECURE_HSTS_SECONDS=31536000
LE_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
LE_SECURE_HSTS_PRELOAD=true
LE_TRUST_X_FORWARDED_PROTO=true

# ── Monitoring auth (Grafana / Prometheus behind Keycloak oauth2-proxy) ──
# 'bearer' makes Django fetch a Keycloak client-credentials token and send it as
# Authorization: Bearer to the oauth2-proxy. Requires a confidential Keycloak
# client with Service Accounts enabled, and the Grafana/Prometheus oauth2-proxy
# started with --skip-jwt-bearer-tokens=true (+ matching --extra-jwt-issuers).
# Defaults to 'bearer' automatically when KEYCLOAK_MONITORING_CLIENT_SECRET is set.
MONITORING_AUTH_MODE=bearer
KEYCLOAK_MONITORING_CLIENT_ID=linkedeye-monitoring
KEYCLOAK_MONITORING_CLIENT_SECRET=          # store in Vault in production
# Defaults to the SSO Keycloak server/realm; override only if the monitoring
# client lives in a different realm:
# KEYCLOAK_MONITORING_TOKEN_URL=https://<keycloak>/realms/<realm>/protocol/openid-connect/token
# KEYCLOAK_MONITORING_SCOPE=
MONITORING_VERIFY_SSL=false
# Legacy fallback (used when MONITORING_AUTH_MODE=basic):
# GRAFANA_PASSWORD=
# PROMETHEUS_PASSWORD=