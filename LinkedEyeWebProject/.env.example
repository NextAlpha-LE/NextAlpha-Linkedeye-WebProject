# LinkedEye Environment Variables
# Copy this file to .env in the project root (same folder as manage.py) and fill in values.
# For NodePort dev clusters see config/local.env.example
# NEVER commit .env with real credentials to version control

# ─────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────
MYSQL_DB_NAME=linkedeye
MYSQL_DB_USER=root
MYSQL_DB_PASS=your_secure_mysql_password
MYSQL_DB_HOST=mysql.fs-linkedeye
MYSQL_DB_PORT=3306
DJANGO_DB_CONN_MAX_AGE=100

# PostgreSQL (Superset Analytics)
POSTGRES_USER=linkedeyedashboard
POSTGRES_PASS=your_secure_postgres_password
POSTGRES_HOST=postgres.fs-linkedeye
POSTGRES_PORT=5432
POSTGRES_SUPERSET_DB=superset

# ─────────────────────────────────────────────────
# Neo4j Graph Database
# ─────────────────────────────────────────────────
NEO4J_HOST=neo4j.fs-linkedeye
NEO4J_PORT=31105
NEO4J_USER=neo4j
NEO4J_PASS=your_secure_neo4j_password

# ─────────────────────────────────────────────────
# Redis Cache & Sessions
# ─────────────────────────────────────────────────
REDIS_HOST=redis.fs-linkedeye
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password
REDIS_CACHE_URL=redis://:your_secure_redis_password@redis.fs-linkedeye:6379/1

# ─────────────────────────────────────────────────
# RabbitMQ Message Queue
# ─────────────────────────────────────────────────
MQ_HOST=mq.fs-linkedeye
MQ_PORT=5672
MQ_USER=linkedeye
MQ_PASS=linkedeye

# ─────────────────────────────────────────────────
# Elasticsearch
# ─────────────────────────────────────────────────
ELASTIC_HOST=elasticsearch.fs-linkedeye
ELASTIC_PORT=9200
ELASTIC_USER=elastic
ELASTIC_PASS=your_secure_elastic_password

# Prometheus / Grafana (server-side proxy auth for charts and analytics embeds)
PROMETHEUS_USERNAME=prometheus
PROMETHEUS_PASSWORD=your_prometheus_password
GRAFANA_USERNAME=grafana
GRAFANA_PASSWORD=your_grafana_password

# ─────────────────────────────────────────────────
# HashiCorp Vault — Application Secrets
# ─────────────────────────────────────────────────
# Device/automation credentials: managed via Admin UI (/vault/)
# Django infrastructure secrets: KV bundle at secret/linkedeye/app

# Enable Vault as source for Django app secrets (production)
VAULT_APP_SECRETS_ENABLED=false

# Vault connectivity (Django reads app secrets; device CRUD uses same host)
VAULT_HOST=vault.fs-linkedeye
VAULT_PORT=8200
VAULT_SCHEME=http

# App secrets KV path (KV v1 engine mounted at "secret/")
VAULT_APP_SECRETS_PATH=secret/linkedeye/app

# AppRole credentials for Django (create with: python manage.py vault_setup_django_approle)
VAULT_APP_ROLE_ID=
VAULT_APP_SECRET_ID=

# Bootstrap only — do not use root token in production Django pods
# VAULT_TOKEN=

# Cache Vault reads (seconds)
VAULT_SECRETS_CACHE_TTL=300

# Keys in the Vault bundle (seed with: python manage.py vault_seed_app_secrets)
# SECRET_KEY, MYSQL_DB_PASS, POSTGRES_PASS, NEO4J_PASS, REDIS_PASSWORD,
# ELASTIC_PASS, LINKEDEYE_EMAIL_APPKEY, GOOGLE_SECRET, TOTP_MASTER_KEY,
# ADMIN_DEFAULT_PASSWORD, AZURE_CLIENT_SECRET, SMTP_PASSWORD

# ─────────────────────────────────────────────────
# Email Configuration (Office365)
# ─────────────────────────────────────────────────
LINKEDEYE_EMAIL=eva@finspot.in
LINKEDEYE_EMAIL_APPKEY=your_office365_app_password

# Apprise Notification Service
APPRISE_HOST=apprise.fs-linkedeye
APPRISE_PORT=8000

# ─────────────────────────────────────────────────
# Authentication & Security
# ─────────────────────────────────────────────────
# Django Secret Key - MUST be set in production
SECRET_KEY=your_super_secret_django_key_min_50_chars

# Google SSO
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_SECRET=your_google_client_secret
GOOGLE_ALLOW_DOMAINS=["finspot.in"]
GOOGLE_SITE_ID=1

# Azure AD (configured in login/aad.config.json)

# TOTP Master Key (for Google Authenticator)
TOTP_MASTER_KEY=your_super_secret_totp_master_key

# ─────────────────────────────────────────────────
# Application URLs
# ─────────────────────────────────────────────────
PORTAL_URL=https://linkedeye.finspot.in
ANALYTICS_DASHBOARD_PREFIX_URL=http://superset.fs-linkedeye:8088/
WEBSOCKET_PREFIX_URL=wss://linkedeye.finspot.in/
WEBSOCKET_STATS_IP=

# Optional: override per-request via ?ip= on /dashboard/getwebsocupdate

# CSRF Trusted Origins
LE_CSRF_TRUSTED_ORIGINS=["https://*.finspot.in", "https://linkedeye.finspot.in"]

# ─────────────────────────────────────────────────
# Memory Guard Middleware (Optional)
# ─────────────────────────────────────────────────
MEMORY_GUARD_WARN_MB=768
MEMORY_GUARD_CRIT_MB=1024

# ─────────────────────────────────────────────────
# Domain Configuration
# ─────────────────────────────────────────────────
DOMAIN_NAME=finspot.in
