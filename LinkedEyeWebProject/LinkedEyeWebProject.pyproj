POSTGRES_HOST=172.16.0.22
POSTGRES_PORT=31445
POSTGRES_PASS=linkedeye
POSTGRES_SUPERSET_DB=superset
POSTGRES_USER=linkedeye</Environment>
  </PropertyGroup>
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>8efd55e5-9658-4861-b1ac-6d669bafa12e</ProjectGuid>
